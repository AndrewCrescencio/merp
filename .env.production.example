# Copie para .env e ajuste os valores. Este template documenta o formato de
# PRODUÇÃO (docker compose -f docker-compose.prod.yml). Desenvolvimento local
# usa `docker compose up` com os defaults embutidos do compose (sem .env).
#
# o compose prod NÃO injeta mais o .env inteiro no container — apenas
# as variáveis declaradas em environment entram, e as obrigatórias usam
# ${VAR:?} (fail-closed). Valores errados aqui sobem produção com links de
# verificação/reset quebrados e trustedOrigins incorreto — confira cada um.
#
# [AJUSTE] ATENÇÃO: este arquivo é só um TEMPLATE. Antes de subir produção,
# troque TODOS os valores 'change-me' por valores reais (segredos via
# `openssl rand -base64 48`). O compose prod usa ${VAR:?} (fail-closed),
# então variável ausente derruba o boot — mas variável com valor placeholder
# sobe normalmente e quebra em runtime.

# Database
# Owner role — usado por migrações (pnpm run db:migrate:full). NUNCA chega ao
# container do app — só é lida pelo host/CI/migrações.
#
# [DEV] As senhas abaixo são os defaults do próprio docker-compose.yml
# (POSTGRES_PASSWORD/POSTGRES_USER) — mantidas iguais de propósito para que
# `make init` funcione sem ajuste manual. O volume `pgdata` só recebe
# POSTGRES_PASSWORD na PRIMEIRA inicialização, então trocar só o .env contra um
# volume já criado resulta em 28P01 (senha recusada). TROQUE EM PRODUÇÃO.
#
# [AJUSTE] ATENÇÃO ao hostname: `postgres` só resolve DENTRO da tenant-starter_network
# (ex.: `docker compose exec app pnpm exec drizzle-kit migrate`). Se rodar no host,
# troque `postgres` por `127.0.0.1`:
#   DATABASE_URL=postgres://merp:merp@127.0.0.1:5432/merp
DATABASE_URL=postgres://merp:merp@postgres:5432/merp
# App role (non-owner, non-superuser) — usada pelo app em runtime para o RLS
# vigorar. Obrigatória em produção (boot recusado sem ela).
APP_DATABASE_URL=postgres://merp_app:merp_app@postgres:5432/merp

# ---------------------------------------------------------------------------
# Driver do banco da aplicação (runtime). Trocando apenas DB_DRIVER e
# APP_DATABASE_URL o app muda de Postgres container ↔ Neon sem tocar em código.
#   postgres-js (default): Postgres local/container OU Neon via TCP
#                          (servidor Node). No Neon use a URL POOLED (-pooler)
#                          com sslmode=require; o driver desliga prepared
#                          statements automaticamente (PgBouncer, modo transação).
#   neon-serverless:     Neon serverless via WebSocket (Pool). Os pacotes estão
#                          em package.json (@neondatabase/serverless + ws). Use
#                          DB_DRIVER=neon-serverless para ativar.
# ---------------------------------------------------------------------------
DB_DRIVER=postgres-js
# Para Neon (pooled, servidor Node):
# DB_DRIVER=postgres-js
# APP_DATABASE_URL=postgres://merp_app:merp_app@ep-xxx-pooler.us-east-1.aws.neon.tech/merp?sslmode=require
#
# Para Neon serverless (opcional):
# DB_DRIVER=neon-serverless
# APP_DATABASE_URL=postgres://merp_app:merp_app@ep-xxx.us-east-1.aws.neon.tech/merp?sslmode=require
#
# IMPORTANTE: DATABASE_URL (owner) deve ser a URL DIRETA (sem -pooler) — a
# URL de pooler quebra migrações (PgBouncer modo transação não aceita DDL
# preparado/transações longas). DATABASE_URL nunca é lida pelo app em runtime.
DB_USER=merp
DB_PASSWORD=merp
DB_NAME=merp

# Better Auth
# Obrigatória em produção com >= 32 caracteres (boot recusado).
# [AJUSTE] Gere com: openssl rand -base64 48
# O valor abaixo é propositalmente curto: copiar o exemplo sem trocar faz o
# boot recusar em produção, em vez de subir assinando cookies e tokens de
# verificação com um segredo publicado no repositório.
BETTER_AUTH_SECRET=change-me
# Domínio público real — usada para gerar os links de verificação/reset e o
# redirect do reset (nunca localhost em produção).
BETTER_AUTH_URL=https://seu-dominio.com

# CORS — domínio público real. É baked no build (nuxt.config.ts) E
# lida em runtime (trustedOrigins do better-auth, shared/auth.ts).
CORS_ORIGIN=https://seu-dominio.com

# CSRF — segredo para assinar tokens double-submit (>= 32 chars, obrigatório em produção)
# [AJUSTE] Gere com: openssl rand -base64 48
# Curto de propósito: copiar o exemplo sem trocar recusa o boot em produção.
CSRF_SECRET=change-me

# Let's Encrypt (certbot webroot, serviço `certbot` do compose prod)
DOMAIN=seu-dominio.com
CERTBOT_EMAIL=admin@seu-dominio.com

# Transactional emails (Resend) — deactivation notice, email
# verification and password reset links. Without RESEND_API_KEY
# the emails are skipped with a warning (login behavior is unaffected;
# however an unverified account stays blocked at login — 403
# email_not_verified — until a verification email is delivered).
RESEND_API_KEY=re_change-me
RESEND_FROM=no-reply@seu-dominio.com

# Só 'true' quando rodar atrás de um proxy reverso que SOBRESCREVE
# X-Forwarded-For (nginx, Cloudflare). Com 'false', vale o endereço do socket
# e o header é ignorado — impede IP forjado em eventos de auditoria e no rate
# limit por IP.
#
# TRUSTED_PROXY_CIDRS = lista de faixas de IP dos proxies em que confiamos, na
# notação CIDR ("IP/bits"): 172.28.0.0/16 = de 172.28.0.0 a 172.28.255.255;
# /32 = um único IPv4 (ex.: 127.0.0.1/32). Várias entradas separadas por
# vírgula, ex.: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Obrigatória quando TRUST_PROXY=true (fail-closed) — sem ela o boot de
# produção é recusado. Por quê: server/utils/shared/ip.ts.
#
# No stack prod (docker-compose.prod.yml) a subnet tenant-starter_network está fixada em
# 172.28.0.0/16 e a variável já vem de lá — não sobreponha aqui, a menos que
# tenha mudado a subnet.
TRUST_PROXY=true
#TRUSTED_PROXY_CIDRS=172.28.0.0/16

# Server (o compose prod fixa PORT=3000 — o nginx proxy para app:3000)
PORT=3000
HOST=0.0.0.0

# Logging (shared/logger.ts) — debug|info|warn|error, default info
#LOG_LEVEL=info

# [AJUSTE] Porta do Postgres no HOST (a porta interna no container é sempre
# 5432). O compose publica em 127.0.0.1:${DB_PORT}, então mude aqui se já
# tiver outro Postgres rodando na 5432 do host.
DB_PORT=5432

# Environment
NODE_ENV=production

# Retenção de auth_event (dias), repassada ao serviço app. Default 90, mínimo
# 30 imposto no banco. Uma linha session_validated é gravada por request
# autenticado; sem retenção a tabela cresce sem limite. A task lê esta variável
# em server/tasks/purge-auth-event.ts.
AUTH_EVENT_RETENTION_DAYS=90