{
  "name": "merp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate:full": "drizzle-kit migrate && tsx scripts/apply-custom-sql.ts"
  },
  "lint-staged": {
    "*.{ts,mjs,vue}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@nuxt/eslint": "^1.17.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^25.9.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitropack": "2.13.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
