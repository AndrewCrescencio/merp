{
  "name": "merp",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "db:migrate:full": "tsx --env-file-if-exists=.env scripts/pre-migrate.ts && drizzle-kit migrate && tsx --env-file-if-exists=.env scripts/apply-custom-sql.ts"
  },
  "lint-staged": {
    "*.{ts,mjs,vue}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@nuxt/eslint": "^1.17.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.1",
    "postgres": "^3.4.9",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitropack": "^2.13.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@simple-git/argv-parser@<2.0.1": "^2.0.1",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "browserslist": "^4.28.7",
    "devalue": "^5.9.1",
    "js-yaml": "^4.3.2",
    "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
    "nanoid@<3.3.18": "3.3.18",
    "postcss": "^8.5.23",
    "shell-quote": "^1.8.5",
    "svgo": "^4.1.0",
    "tar": "^7.5.22"
  }
}
