{
  "name": "merp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate:full": "drizzle-kit migrate && tsx scripts/apply-custom-sql.ts",
    "docs:index": "tsx docs/_meta/scripts/generate-index.ts",
    "docs:new": "tsx docs/_meta/scripts/new-doc.ts",
    "docs:deprecate": "tsx docs/_scripts/deprecate.ts",
    "docs:archive": "tsx docs/_meta/scripts/archive.ts",
    "docs:lint": "npx markdownlint-cli docs/**/*.md --config .markdownlint.json",
    "docs:spell": "cspell docs/**/*.md"
  },
  "lint-staged": {
    "*.{ts,mjs,vue}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@nuxt/eslint": "^1.17.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^25.9.3",
    "cspell": "^8.14.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^11.0.0",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "markdownlint-cli": "^0.43.0",
    "nitropack": "2.13.4",
    "prettier": "^3.8.4",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  }
}
