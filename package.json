{
  "name": "merp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate:full": "tsx --env-file-if-exists=.env scripts/pre-migrate.ts && drizzle-kit migrate && tsx --env-file-if-exists=.env scripts/apply-custom-sql.ts",
    "docs:index": "tsx docs/_meta/scripts/generate-index.ts",
    "docs:new": "tsx docs/_meta/scripts/new-doc.ts",
    "docs:deprecate": "tsx docs/_scripts/deprecate.ts",
    "docs:archive": "tsx docs/_meta/scripts/archive.ts",
    "docs:lint": "npx markdownlint-cli docs/**/*.md --config .markdownlint.json",
    "docs:spell": "cspell docs/**/*.md"
  },
  "lint-staged": {
    "*.{ts,mjs,vue}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@nuxt/eslint": "^1.17.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.6.0",
    "postgres": "^3.4.9",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^25.9.9",
    "cspell": "^8.19.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^11.1.0",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.43.0",
    "nitropack": "^2.13.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}
