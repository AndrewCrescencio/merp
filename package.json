{
  "name": "nuxt-tenant-starter",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "node scripts/generate-tailwind.mjs && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "pretest": "node scripts/generate-tailwind.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.tests.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:migrations": "tsx scripts/check-migration-prefixes.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:routes && pnpm run check:migrations",
    "db:migrate:full": "tsx --env-file-if-exists=.env scripts/check-db.ts && CI=true FORCE_COLOR=0 drizzle-kit migrate && tsx --env-file-if-exists=.env scripts/verify-rls.ts",
    "db:smoke": "tsx --env-file-if-exists=.env scripts/db-smoke.ts"
  },
  "lint-staged": {
    "*.{ts,mjs,vue}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.7.0",
    "postgres": "^3.4.9",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jose": "^6.2.18",
    "lint-staged": "^17.6.2",
    "nitropack": "^2.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "@simple-git/argv-parser@<2.0.1": "^2.0.1",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "browserslist": "^4.28.7",
    "devalue": "^5.9.1",
    "js-yaml": "^4.3.2",
    "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
    "nanoid@<3.3.18": "3.3.18",
    "shell-quote": "^1.8.5",
    "svgo": "^4.1.0",
    "tar": "^7.5.22"
  },
  "packageManager": "pnpm@12.23.0"
}
