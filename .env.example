# Database
# Owner role — used by migrations (drizzle-kit push/migrate)
DATABASE_URL=postgres://merp:merp@postgres:5432/merp
# App role (non-owner, non-superuser) — used by the application at runtime.
# Required in production so RLS policies are enforced (see docs/multi-tenancy/withtenant-rls-review.md).
# Falls back to DATABASE_URL (owner) when unset — dev local only.
#APP_DATABASE_URL=postgres://merp_app:change-me@postgres:5432/merp
DB_USER=merp
DB_PASSWORD=merp
DB_NAME=merp

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Set to 'true' ONLY when running behind a reverse proxy that overwrites
# X-Forwarded-For (e.g. nginx, Cloudflare). When false, the socket address
# is used and the header is ignored — preventing IP spoofing of audit events
# and per-IP rate limiting.
TRUST_PROXY=false

# Server
PORT=5173
HOST=0.0.0.0

# Database port (for host access with db service only)
DB_PORT=5432

# Environment
NODE_ENV=development
