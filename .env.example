# Desenvolvimento local. Copie para `.env` e rode:
#   docker compose up -d postgres
#   npm run db:migrate:full
#   npm run dev
#
# Todos os valores abaixo funcionam sem edição: Postgres em 127.0.0.1 (localhost
# ou container dev), Nuxt em http://localhost:3000, NODE_ENV=development.
# Não use este arquivo em produção — para produção copie `.env.production.example`
# e troque os placeholders antes do boot (o boot de produção é recusado com
# valores inválidos: server/plugins/validate-env.ts).

# Database (dev local: Postgres no host ou container via docker compose)
DATABASE_URL=postgres://merp:merp@127.0.0.1:5432/merp
APP_DATABASE_URL=postgres://merp_app:merp_app@127.0.0.1:5432/merp
DB_DRIVER=postgres-js
DB_USER=merp
DB_PASSWORD=merp
DB_NAME=merp
DB_PORT=5432

# Better Auth (dev — segredo de 44 chars, suficiente para o melhor-auth)
BETTER_AUTH_SECRET=dev-local-secret-do-not-use-in-production-xyz7890ab
BETTER_AUTH_URL=http://localhost:3000

# CORS (dev)
CORS_ORIGIN=http://localhost:3000

# CSRF (dev)
CSRF_SECRET=dev-csrf-secret-do-not-use-in-production-change-me-32chars

# Emails (dev — sem Resend, envio pulado com warning)
RESEND_API_KEY=
RESEND_FROM=no-reply@localhost

# Proxy (dev — sem proxy reverso na frente)
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
