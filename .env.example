# Database
DATABASE_URL=postgres://merp:merp@postgres:5432/merp
DB_USER=merp
DB_PASSWORD=merp
DB_NAME=merp

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Server
PORT=3000
HOST=0.0.0.0

# Database port (for host access with db service only)
DB_PORT=5432

# Environment
NODE_ENV=development
